PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# API rate limit (optional; defaults: 400 requests / 15 min per IP)
# RATE_LIMIT_MAX=400
# RATE_LIMIT_WINDOW_MS=900000

# MongoDB (required for accounts, orders, and pilot leads)
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/naolab
# Atlas (same cluster, DB name /naolab — no slash before ?):
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/naolab?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://127.0.0.1:27017/naolab
# Optional pool cap (default 10, max 50) when scaling API replicas against one cluster
# MONGODB_MAX_POOL_SIZE=20
# Demo user + sample data: npm run seed:all (see scripts/seed-demo-user.js)

# JWT signing (required in production; httpOnly session cookie)
JWT_SECRET=

# Open registration without invite code (default: true in development, false in production)
# ALLOW_OPEN_REGISTRATION=false

# Pilot lead notifications (optional — logs to console when unset)
# RESEND_API_KEY=re_xxxxxxxx
# PILOT_NOTIFY_TO=you@company.com
# PILOT_NOTIFY_FROM=NaoLab <onboarding@yourdomain.com>

# INTTRA carrier booking (Transport module). Default mock = simulated acknowledgment without credentials.
# CARRIER_BOOKING_MODE=mock
# INTTRA_API_KEY=
# INTTRA_API_BASE=https://api.inttra.com
